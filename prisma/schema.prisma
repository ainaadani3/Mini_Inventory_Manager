generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inventori {
  id              Int      @id @default(autoincrement())
  kod_item        String   @unique
  nama_produk     String
  kategori        String
  kuantiti_semasa Int
  paras_minimum   Int
  harga_seunit    Float
  createdAt       DateTime @default(now())
}
